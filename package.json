{
  "name": "personal-phone-assistant-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.voice.json && tsc --noEmit -p tsconfig.notifications.json",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --config workers/auth/wrangler.jsonc && wrangler deploy --dry-run --config workers/mcp/wrangler.jsonc && wrangler deploy --dry-run --config workers/voice/wrangler.jsonc && npm run build:notifications && npm run build:inbound",
    "deploy:auth": "wrangler deploy --config workers/auth/wrangler.jsonc",
    "deploy:mcp": "wrangler deploy --config workers/mcp/wrangler.jsonc",
    "configure": "node scripts/configure.mjs",
    "predeploy:auth": "node scripts/preflight.mjs",
    "predeploy:mcp": "node scripts/preflight.mjs",
    "deploy:bootstrap": "node scripts/bootstrap.mjs",
    "format": "prettier --write workers tests scripts *.json .github/workflows/*.yml README.md",
    "smoke:live": "node scripts/smoke-live.mjs",
    "test:phone-voice": "node scripts/verify-phone-voice.mjs",
    "test:voice-edge": "node scripts/test-voice-edge.mjs",
    "test:voice-campaign": "node scripts/offline-voice-campaign.mjs",
    "test:voice-timings": "node scripts/offline-ivr-timing-sweep.mjs",
    "test:voice-handoff": "node scripts/offline-voice-handoff-sweep.mjs",
    "build:notifications": "esbuild workers/notifications/src/provider.mjs --bundle --format=esm --platform=browser --outfile=.wrangler/summary-build.mjs",
    "build:inbound": "esbuild workers/inbound/src/intake.mjs --bundle --format=esm --platform=browser --outfile=.wrangler/inbound-build.mjs",
    "test:voice-pickup": "node scripts/offline-pickup-sweep.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "libphonenumber-js": "1.13.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/node": "22.20.5",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.152.0",
    "ws": "8.22.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
