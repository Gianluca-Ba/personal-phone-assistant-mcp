{
  "name": "personal-phone-assistant-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    {
      "binding": "AUTH_SERVER",
      "service": "personal-phone-assistant-auth",
      "entrypoint": "AuthServer",
    },
    {
      "binding": "PHONE_API",
      "service": "personal-phone-assistant",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "phone-assistant-db",
      "database_id": "f8604adb-ac12-4298-a9be-327727a20675",
    },
  ],
  "vars": {
    "OWNER_TOKEN_VERSION": "1",
    "OUTBOUND_ENABLED": "true",
    "OUTBOUND_CONTRACT_VERIFIED": "true",
    "OUTBOUND_ALLOWED_DESTINATIONS": "[]",
    "OUTBOUND_DESTINATION_POLICY": "all_standard",
    "OUTBOUND_BLOCKED_PREFIXES": "[\"+870\",\"+878\",\"+881\",\"+882\",\"+883\",\"+979\"]",
    "OUTBOUND_BLOCKED_DESTINATIONS": "[]",
    "OUTBOUND_BLOCKED_NUMBER_TYPES": "[]",
    "SCHEMA_MAPPING": "{\"calls\":{\"id\":\"id\",\"phone\":\"caller_number\",\"destination\":\"destination_number\",\"time\":\"created_at\",\"time_format\":\"iso\"},\"call_summaries\":{\"call\":\"call_id\",\"summary\":\"summary_it\",\"actions\":\"action_required\"},\"outbound_requests\":{\"phone\":\"destination_number\",\"time\":\"created_at\",\"time_format\":\"iso\"}}",
    "OUTBOUND_RATE_LIMIT_PER_HOUR": "5",
    "OUTBOUND_APPROVAL_TTL_MINUTES": "30",
    "OUTBOUND_EXECUTION_ENABLED": "true",
    "OUTBOUND_CONFIRMATION_POLICY": "conversation-policy-v1",
    "OUTBOUND_PRIVATE_ALLOWLIST_CONFIGURED": "true",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OUTBOUND_GATE",
        "class_name": "OutboundGate",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OutboundGate"],
    },
  ],
  "preview_urls": false,
  "workers_dev": true,
  "observability": {
    "enabled": false,
  },
}
