{
  "name": "personal-phone-assistant-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "REPLACE_WITH_EXISTING_OAUTH_KV_ID",
    },
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "vars": {
    "OWNER_TOKEN_VERSION": "1",
  },
  "services": [
    {
      "binding": "MCP_SERVER",
      "service": "personal-phone-assistant-mcp",
      "entrypoint": "ApprovalServer",
    },
  ],
}
